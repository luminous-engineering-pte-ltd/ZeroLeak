---
import { navItems, services } from '../../data/services';
---
<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
  <nav class="container-premium flex min-h-[76px] items-center justify-between gap-6" aria-label="Main navigation">
    <a href="/" class="flex items-center gap-3 font-display text-2xl font-bold text-main">
      <span class="grid h-10 w-10 place-items-center border border-primary-hover text-sm text-primary">ZL</span>
      ZeroLeak
    </a>
    <div class="hidden items-center gap-8 lg:flex">
      {navItems.map(([label, href]) => label === 'Services' ? (
        <div data-desktop-services>
          <button type="button" class="desktop-services-button" data-desktop-services-button aria-haspopup="true" aria-expanded="false" aria-controls="desktop-services-menu">
            <span>Services</span>
            <svg aria-hidden="true" class="desktop-services-chevron h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div id="desktop-services-menu" hidden class="desktop-services-dropdown border border-line bg-white p-6 shadow-premium">
            <div class="grid max-h-[74vh] grid-cols-3 gap-4 overflow-auto">
              {services.map((service) => (
                <div class="border border-line p-4 transition hover:bg-soft">
                  <a href={`/services/${service.slug}`} class="flex items-start gap-3 hover:text-primary">
                    <span class="text-xs font-semibold text-primary">{service.number}</span>
                    <span><strong class="block text-main">{service.name}</strong><small class="mt-1 block text-muted">{service.description}</small></span>
                  </a>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {service.subServices.map((sub) => <a class="border border-line px-2 py-1 text-xs text-muted transition hover:border-primary-hover hover:bg-soft hover:text-primary" href={`/services/${service.slug}/${sub.slug}`}>{sub.name}</a>)}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ) : <a href={href} class="text-sm font-bold uppercase tracking-[.12em] text-main/80 hover:text-primary">{label}</a>)}
    </div>
    <div class="hidden items-center gap-3 lg:flex">
      <a href="tel:+6581836772" class="desktop-call-link" aria-label="Call ZeroLeak" title="Call ZeroLeak" data-tooltip="Call ZeroLeak">
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </a>
      <a href="/contact" class="btn btn-primary">Get Quote</a>
    </div>
    <button class="mobile-icon-button lg:hidden" data-mobile-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 18h16"></path>
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" hidden class="mobile-collapsible mobile-menu-panel border-t border-line bg-white lg:hidden">
    <div class="container-premium py-3">
      {navItems.map(([label, href]) => label === 'Services' ? (
        <div class="border-b border-line py-1">
          <button class="mobile-nav-row" data-mobile-toggle aria-expanded="false" aria-controls="mobile-services">
            <span>Services</span>
            <svg aria-hidden="true" class="mobile-chevron h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div id="mobile-services" hidden class="mobile-collapsible pb-2">
            {services.map((service) => (
              <div class="border-t border-line">
                <div class="flex items-center gap-2">
                  <a href={`/services/${service.slug}`} class="mobile-service-link">{service.name}</a>
                  <button class="mobile-chevron-button" data-mobile-toggle aria-expanded="false" aria-controls={`mobile-service-${service.slug}`} aria-label={`Toggle ${service.name} services`}>
                    <svg aria-hidden="true" class="mobile-chevron h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </button>
                </div>
                <div id={`mobile-service-${service.slug}`} hidden class="mobile-collapsible">
                  <div class="grid gap-1 pb-3 pl-4">
                    {service.subServices.map((sub) => <a href={`/services/${service.slug}/${sub.slug}`} class="mobile-subservice-link">{sub.name}</a>)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ) : <a href={href} class="mobile-nav-row border-b border-line">{label}</a>)}
      <a href="/contact" class="btn btn-primary mt-4 w-full">Get Quote</a>
    </div>
  </div>
  <script>
    const servicesRoot = document.querySelector('[data-desktop-services]');
    const servicesButton = document.querySelector('[data-desktop-services-button]');
    const servicesDropdown = document.getElementById('desktop-services-menu');

    if (servicesRoot && servicesButton && servicesDropdown) {
      const closeServicesDropdown = () => {
        servicesButton.setAttribute('aria-expanded', 'false');
        servicesDropdown.classList.remove('is-open');
        servicesDropdown.addEventListener('transitionend', () => {
          if (!servicesDropdown.classList.contains('is-open')) servicesDropdown.hidden = true;
        }, { once: true });
      };

      const openServicesDropdown = () => {
        servicesDropdown.hidden = false;
        servicesButton.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => servicesDropdown.classList.add('is-open'));
      };

      servicesButton.addEventListener('click', (event) => {
        event.stopPropagation();
        const expanded = servicesButton.getAttribute('aria-expanded') === 'true';
        expanded ? closeServicesDropdown() : openServicesDropdown();
      });

      document.addEventListener('click', (event) => {
        if (
          servicesButton.getAttribute('aria-expanded') === 'true' &&
          !servicesRoot.contains(event.target)
        ) {
          closeServicesDropdown();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && servicesButton.getAttribute('aria-expanded') === 'true') {
          closeServicesDropdown();
          servicesButton.focus();
        }
      });
    }
  </script>
</header>
