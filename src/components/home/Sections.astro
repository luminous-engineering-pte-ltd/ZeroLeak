---
import { services, featuredSolutions } from '../../data/services';
const trust = ['Professional Workmanship', 'Quality Materials', 'Singapore-Wide Service', 'Practical Solutions', 'Transparent Quotations'];
const why = ['Experienced Specialists', 'Proper Diagnosis', 'Quality Materials', 'Transparent Quotations', 'Safety-Conscious Work', 'Singapore-Wide Coverage'];
const problems = ['Water Leakage', 'Roof Problems', 'Concrete Cracks', 'Damp & Mould', 'Structural Issues'];
const process = ['Inspection', 'Diagnosis', 'Recommendation', 'Execution', 'Final Inspection'];
const testimonials = [
  ['Ms Tan', 'Condominium bathroom waterproofing', 'Clear explanation before work started and a tidy handover after completion.', '5.0'],
  ['Mr Lim', 'Landed roof leakage repair', 'The team helped trace the likely source and recommended a practical repair scope.', '5.0'],
  ['Facilities Manager', 'Commercial wall leakage', 'Professional coordination and straightforward communication throughout the job.', '4.8']
];
const faqs = [
  'How do you identify the source of a water leak?', 'How long does waterproofing normally last?', 'Do you provide roof leakage repair?', 'Can waterproofing be done without hacking?', 'Do you provide commercial waterproofing?', 'Can you repair wall and slab cracks?', 'Do you provide grouting and injection works?', 'Do you provide thermal imaging?', 'Which properties do you service?', 'How do I request a quotation?'
];
---
<section class="border-y border-line bg-white py-5"><div class="container-premium grid gap-3 text-sm font-bold text-main/75 md:grid-cols-5">{trust.map((t) => <div class="border-l border-primary-hover/40 pl-4">{t}</div>)}</div></section>
<section class="section bg-lavender"><div class="container-premium"><div class="eyebrow">Our Specialist Services</div><h2 class="display mt-3 text-4xl font-bold text-main md:text-5xl">Protection, repair and strengthening under one roof.</h2><div class="mt-10 grid gap-4 md:grid-cols-3">{services.map((s, i) => <a href={`/services/${s.slug}`} class={`panel block p-6 transition hover:border-primary-hover hover:bg-soft ${i % 2 ? 'bg-soft/70' : ''}`}><span class="text-sm font-black text-primary">{s.number}</span><h3 class="mt-5 font-display text-2xl font-bold text-main">{s.name}</h3><p class="mt-3 text-muted">{s.description}</p><span class="mt-6 inline-block font-bold text-primary">Explore -></span></a>)}</div></div></section>
<section class="section bg-soft"><div class="container-premium grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><div class="eyebrow">Why Choose ZeroLeak</div><h2 class="display mt-3 text-4xl font-bold text-main">Why Property Owners Choose ZeroLeak</h2><p class="mt-5 text-muted">Professional recommendations built around inspection, site realities and long-term building protection.</p></div><div class="grid gap-4 sm:grid-cols-2">{why.map((w) => <div class="border-t border-primary-hover/50 py-5"><h3 class="font-display text-2xl text-main">{w}</h3><p class="mt-2 text-muted">Reliable waterproofing, roofing, repair and building protection with clear communication and safety-conscious site practices.</p></div>)}</div></div></section>
<section class="section bg-primary-dark text-white"><div class="container-premium"><div class="eyebrow text-lavender">Problems & Solutions</div><div class="mt-8 grid gap-4 md:grid-cols-5">{problems.map((p, i) => <div class="border border-white/15 p-5"><span class="text-lavender">0{i + 1}</span><h3 class="mt-8 font-display text-2xl">{p}</h3><p class="mt-3 text-white/65">Assess the visible issue, identify likely causes and apply an appropriate repair or protection method.</p></div>)}</div></div></section>
<section class="section bg-white"><div class="container-premium"><div class="eyebrow">Our Working Process</div><h2 class="display mt-3 text-4xl font-bold text-main">From inspection to final review.</h2><div class="mt-10 grid gap-4 md:grid-cols-5">{process.map((p, i) => <div class="relative border-l border-primary-hover pl-5 md:border-l-0 md:border-t md:pt-5"><span class="text-sm font-black text-primary">0{i + 1}</span><h3 class="mt-3 font-display text-2xl text-main">{p}</h3><p class="mt-2 text-sm text-muted">Understand the site, recommend the right intervention and complete the agreed scope professionally.</p></div>)}</div></div></section>
<section class="section bg-lavender"><div class="container-premium"><div class="eyebrow">Featured Solutions</div><h2 class="display mt-3 text-4xl font-bold text-main">Common issues we help resolve.</h2><div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{featuredSolutions.map(([name, service, sub]) => <a class="border border-line bg-white p-5 font-bold text-main transition hover:border-primary-hover hover:bg-soft" href={`/services/${service}/${sub}`}>{name} <span class="text-primary">-></span></a>)}</div></div></section>
<section class="section bg-soft"><div class="container-premium grid gap-10 lg:grid-cols-2"><img class="aspect-[4/3] w-full object-cover shadow-premium" src="https://images.unsplash.com/photo-1565967511849-76a60a516170?auto=format&fit=crop&w=1000&q=75" alt="Singapore city skyline and building environment" loading="lazy" /><div><div class="eyebrow">Singapore Coverage</div><h2 class="display mt-3 text-4xl font-bold text-main">Building Protection Across Singapore</h2><p class="mt-5 text-muted">ZeroLeak supports landed homes, condominiums, commercial buildings, offices, industrial properties, residential properties and other building environments.</p></div></div></section>
<section class="section bg-white"><div class="container-premium"><div class="eyebrow">Testimonials</div><h2 class="display mt-3 text-4xl font-bold text-main">Concise, practical and professional.</h2><div class="mt-9 grid gap-4 md:grid-cols-3">{testimonials.map(([name, context, text, rating]) => <figure class="panel p-6"><div class="font-bold text-primary">{rating} / 5</div><blockquote class="mt-5 text-muted">"{text}"</blockquote><figcaption class="mt-6 font-bold text-main">{name}<span class="block text-sm font-normal text-muted">{context}</span></figcaption></figure>)}</div></div></section>
<section class="section bg-lavender"><div class="container-premium max-w-4xl"><div class="eyebrow">FAQ</div><h2 class="display mt-3 text-4xl font-bold text-main">Frequently asked questions.</h2><div class="mt-8 grid gap-3">{faqs.map((q, i) => <div class="border border-line bg-white"><button class="flex w-full justify-between p-5 text-left font-bold text-main" data-accordion aria-expanded="false" aria-controls={`faq-${i}`}>{q}<span class="text-primary">+</span></button><p id={`faq-${i}`} hidden class="bg-soft px-5 pb-5 pt-1 text-muted">ZeroLeak reviews the site condition and explains practical next steps before work proceeds. For project-specific advice, request an inspection or quotation.</p></div>)}</div></div></section>
<section class="section bg-primary-dark text-white"><div class="container-premium text-center"><div class="eyebrow text-lavender">Get Help</div><h2 class="display mx-auto mt-3 max-w-3xl text-4xl font-bold">Got a Leak, Crack or Roofing Problem?</h2><p class="mx-auto mt-5 max-w-2xl text-white/70">Let ZeroLeak assess the problem and recommend a practical solution for your property.</p><div class="mt-8 flex justify-center gap-3 flex-wrap"><a href="/contact" class="btn btn-light">Get a Free Quote</a><a href="https://wa.me/6581836772" class="btn border-white/25 text-white">WhatsApp Us</a></div><p class="mt-4 font-bold text-lavender">+65 8183 6772</p></div></section>
