---
import { site } from '../../data/site';
---
<section class="relative overflow-hidden bg-soft">
  <div class="container-premium grid min-h-[calc(100vh-76px)] items-center gap-10 py-14 lg:grid-cols-[.95fr_1.05fr]">
    <div class="reveal">
      <div class="eyebrow">Singapore building protection specialists</div>
      <h1 class="display mt-5 max-w-3xl text-5xl font-bold leading-[1.04] text-main md:text-7xl">Professional Waterproofing, Roofing & Structural Solutions in Singapore</h1>
      <div class="accent-line mt-7"></div>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">ZeroLeak provides professional solutions for water leakage, waterproofing, roofing, concrete repair, grouting and structural protection across Singapore.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/contact">Get a Free Quote</a><a class="btn btn-outline" href="/services">Explore Services</a></div>
      <p class="mt-5 font-bold text-primary">{site.phone}</p>
    </div>
    <div class="relative reveal">
      <img class="aspect-[4/5] w-full object-cover shadow-premium" src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1100&q=78" alt="Premium Singapore building facade with strong architectural lines" width="900" height="1125" />
      <div class="absolute -bottom-5 -left-5 hidden border border-primary-hover bg-white p-6 shadow-premium md:block"><div class="text-xs font-black uppercase tracking-[.14em] text-primary">Inspection → Diagnosis → Repair</div><p class="mt-2 max-w-xs font-display text-2xl text-main">Engineered protection for demanding property conditions.</p></div>
    </div>
  </div>
</section>
