---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { services } from '../../../data/services';

export function getStaticPaths() {
  return services.flatMap((service) => service.subServices.map((subService) => ({
    params: { service: service.slug, subservice: subService.slug },
    props: { service, subService }
  })));
}
const { service, subService } = Astro.props;
const related = service.subServices.filter((item) => item.slug !== subService.slug).slice(0, 4);
---
<MainLayout title={`${subService.name} Singapore | ZeroLeak`} description={subService.description} canonical={`/services/${service.slug}/${subService.slug}`} image={service.image}>
  <section class="bg-soft py-12 md:py-20">
    <div class="container-premium">
      <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: service.name, href: `/services/${service.slug}` }, { label: subService.name, href: `/services/${service.slug}/${subService.slug}` }]} />
      <div class="mt-10 grid items-center gap-10 lg:grid-cols-[1fr_.9fr]">
        <div><div class="eyebrow">{service.name}</div><h1 class="display mt-4 text-5xl font-bold text-main md:text-6xl">{subService.name} Singapore</h1><p class="mt-6 text-lg leading-8 text-muted">{subService.description}</p><a href="/contact" class="btn btn-primary mt-8">Request a Quote</a></div>
        <img class="aspect-[4/3] w-full object-cover shadow-premium" src={service.image} alt={`${subService.name} work in Singapore`} width="900" height="675" />
      </div>
    </div>
  </section>
  <section class="section bg-white"><div class="container-premium grid gap-8 md:grid-cols-3"><div><h2 class="display text-3xl text-main">Benefits</h2>{subService.benefits.map((b) => <p class="mt-4 border-t border-primary-hover/40 pt-4 text-muted">{b}</p>)}</div><div><h2 class="display text-3xl text-main">Applications</h2>{subService.applications.map((a) => <p class="mt-4 border-t border-primary-hover/40 pt-4 text-muted">{a}</p>)}</div><div><h2 class="display text-3xl text-main">Process</h2>{service.process.map((p, i) => <p class="mt-4 border-t border-primary-hover/40 pt-4 text-muted">0{i + 1}. {p}</p>)}</div></div></section>
  <section class="section bg-lavender"><div class="container-premium grid gap-10 lg:grid-cols-2"><div><div class="eyebrow">FAQ</div><h2 class="display mt-3 text-4xl text-main">Practical questions before work starts.</h2></div><div class="grid gap-3">{service.faqs.map(([q,a], i) => <div class="border border-line bg-white"><button class="flex w-full justify-between p-5 text-left font-bold" data-accordion aria-expanded="false" aria-controls={`sub-faq-${i}`}>{q}<span>+</span></button><p id={`sub-faq-${i}`} hidden class="px-5 pb-5 text-muted">{a}</p></div>)}</div></div></section>
  <section class="section bg-soft"><div class="container-premium"><div class="eyebrow">Related Services</div><div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{related.map((item) => <a class="border border-line bg-white p-5 font-bold text-main hover:border-primary-hover" href={`/services/${service.slug}/${item.slug}`}>{item.name} →</a>)}</div></div></section>
  <section class="section bg-primary-dark text-white"><div class="container-premium text-center"><h2 class="display text-4xl">Discuss {subService.name.toLowerCase()} with ZeroLeak.</h2><a href="/contact" class="btn btn-light mt-7">Get a Free Quote</a></div></section>
</MainLayout>
