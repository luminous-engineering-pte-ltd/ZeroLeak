---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { services } from '../../data/services';
---
<MainLayout title="Services | ZeroLeak Singapore" description="Explore ZeroLeak waterproofing, roofing, grouting, concrete repair, leak repair and structural strengthening services in Singapore.">
  <section class="section bg-soft">
    <div class="container-premium">
      <Breadcrumbs items={[{ label: 'Services', href: '/services' }]} />
      <div class="mt-10 max-w-3xl">
        <div class="eyebrow">Services</div>
        <h1 class="display mt-4 text-5xl font-bold text-main md:text-6xl">Specialist Building Protection & Repair Services</h1>
        <p class="mt-6 text-lg leading-8 text-muted">Explore professional services for waterproofing, roofing, leakages, concrete repair, grouting and structural strengthening across Singapore.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <a href={`/services/${service.slug}`} class="panel group block p-6">
            <div class="flex items-center justify-between"><span class="text-sm font-semibold text-primary">{service.number}</span><span class="text-sm text-primary">{service.subServices.length} services</span></div>
            <h2 class="display mt-10 text-3xl font-bold text-main">{service.name}</h2>
            <p class="mt-3 text-muted">{service.description}</p>
            <span class="mt-8 inline-flex font-bold text-primary group-hover:translate-x-1">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
