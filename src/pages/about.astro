---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
const expertise = ['Waterproofing', 'Roofing', 'Grouting', 'Concrete Repair', 'Leak Detection', 'Structural Strengthening'];
const values = ['Reliability', 'Quality', 'Precision', 'Safety', 'Professionalism'];
---

<MainLayout title="About ZeroLeak Singapore" description="Learn about ZeroLeak, a Singapore waterproofing, roofing, repair and structural protection company built around precision and reliability.">
  <section class="section bg-soft"><div class="container-premium"><Breadcrumbs items={[{ label: 'About', href: '/about' }]} /><div class="mt-10 max-w-4xl"><div class="eyebrow">About ZeroLeak</div><h1 class="display mt-4 text-5xl font-bold text-main md:text-6xl">Built Around Protection, Precision & Reliability</h1><p class="mt-6 text-lg leading-8 text-muted">ZeroLeak provides practical building protection solutions for water leakage, waterproofing, roofing, concrete repair, grouting and structural strengthening in Singapore.</p></div></div></section>
  <section class="section bg-white"><div class="container-premium grid gap-10 lg:grid-cols-2"><div><div class="eyebrow">Who We Are</div><h2 class="display mt-3 text-4xl text-main">A professional company focused on durable repair decisions.</h2></div><p class="text-lg leading-8 text-muted">Our work starts with understanding the site condition. We focus on diagnosis, clear recommendations and professional execution so property owners can make informed decisions without inflated claims.</p></div></section>
  <section class="section bg-lavender"><div class="container-premium"><div class="eyebrow">Our Expertise</div><div class="mt-8 grid gap-4 md:grid-cols-3">{expertise.map((item) => <div class="panel p-6"><h3 class="font-display text-3xl text-main">{item}</h3><p class="mt-3 text-muted">Specialist support delivered through inspection, recommendation, execution and review.</p></div>)}</div></div></section>
  <section class="section bg-soft"><div class="container-premium grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><div class="eyebrow">What We Stand For</div><h2 class="display mt-3 text-4xl text-main">Measured, professional and safety-conscious.</h2></div><div class="grid gap-4 sm:grid-cols-2">{values.map((v) => <div class="border-t border-primary-hover pt-5"><h3 class="font-display text-2xl text-main">{v}</h3><p class="mt-2 text-muted">A practical standard for how work is assessed, communicated and completed.</p></div>)}</div></div></section>
  <section class="section bg-primary-dark text-white"><div class="container-premium text-center"><div class="eyebrow text-lavender">Our Approach</div><h2 class="display mt-3 text-4xl">Inspection → Diagnosis → Recommendation → Execution → Final Review</h2><p class="mx-auto mt-5 max-w-2xl text-white/70">This sequence keeps the work grounded in the actual property condition and the agreed repair scope.</p></div></section>
</MainLayout>
