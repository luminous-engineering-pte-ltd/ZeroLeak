---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { site } from '../data/site';
import { services } from '../data/services';
---
<MainLayout title="Contact ZeroLeak Singapore | Request a Free Quote" description="Contact ZeroLeak Singapore for waterproofing, roofing, leakage, concrete repair, grouting and structural protection quotations.">
  <section class="section bg-soft"><div class="container-premium"><Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} /><div class="mt-10 max-w-4xl"><div class="eyebrow">Contact</div><h1 class="display mt-4 text-5xl font-bold text-main md:text-6xl">Let's Solve Your Water, Roofing or Structural Problem</h1></div></div></section>
  <section class="section bg-white"><div class="container-premium grid gap-10 lg:grid-cols-[.75fr_1.25fr]"><aside class="panel p-7"><h2 class="display text-3xl text-main">Contact ZeroLeak</h2><p class="mt-5 text-muted">Phone / WhatsApp</p><a href={site.whatsapp} class="mt-2 block text-2xl font-bold text-primary">{site.phone}</a><p class="mt-6 text-muted">Website</p><p class="mt-2 font-bold text-main">{site.domain}</p></aside><form class="panel grid gap-4 p-7" data-quote-form novalidate><h2 class="display text-3xl text-main">Request a Free Quote</h2><div class="grid gap-4 md:grid-cols-2"><label>Full Name<input required class="mt-2 w-full border border-line p-3" name="name" /></label><label>Email<input required type="email" class="mt-2 w-full border border-line p-3" name="email" /></label><label>Phone Number<input required class="mt-2 w-full border border-line p-3" name="phone" /></label><label>Property Type<select required class="mt-2 w-full border border-line p-3" name="property"><option value="">Select</option><option>Landed Home</option><option>Condominium</option><option>Commercial</option><option>Industrial</option><option>Other</option></select></label><label>Service Required<select required class="mt-2 w-full border border-line p-3" name="service"><option value="">Select</option>{services.map((s) => <option>{s.name}</option>)}</select></label><label>Preferred Date<input required type="date" class="mt-2 w-full border border-line p-3" name="date" /></label></div><label>Message<textarea required class="mt-2 min-h-36 w-full border border-line p-3" name="message"></textarea></label><button class="btn btn-primary w-fit" type="submit">Request a Free Quote</button><p data-form-status class="text-sm font-bold data-[state=error]:text-red-700 data-[state=success]:text-primary"></p></form></div></section>
</MainLayout>
